{
  "name": "meemiart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "test:payments": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/test-payments.ts",
    "test:paddle": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/test-paddle.ts",
    "test:downloads": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/test-downloads.ts",
    "test:paddle-env": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/test-paddle-env.ts",
    "migrate:catalog": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/migrate-catalog-to-production.ts",
    "paddle:webhook-events": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/paddle-webhook-events.ts",
    "paddle:audit": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/paddle-audit.ts",
    "paddle:check": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/check-paddle-env.ts",
    "paddle:sync": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/paddle-sync.ts",
    "check": "npm run typecheck && npm run lint && npm run build",
    "test:reviews": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/test-reviews.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.8.0",
    "@paddle/paddle-js": "^1.6.5",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
