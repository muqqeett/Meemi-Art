generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?
  image                   String?
  passwordHash            String?
  role                    Role                     @default(CUSTOMER)
  phone                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  /// Paddle's own id for this buyer (`ctm_...`). A provider id, deliberately
  /// kept separate from `id` and `email`: Paddle owns it, it means nothing to
  /// this application beyond matching a webhook back to a person, and it must
  /// never be used as an identity or an authorisation key.
  paddleCustomerId        String?                  @unique
  accounts                Account[]
  adminActivity           AdminActivity[]
  cart                    Cart?
  customerProjects        CustomerProject[]        @relation("CustomerProjectOwner")
  downloads               DigitalAccess[]
  emailVerificationTokens EmailVerificationToken[]
  moderatedProjects       CustomerProject[]        @relation("CustomerProjectModerator")
  orders                  Order[]
  passwordResetTokens     PasswordResetToken[]
  reviews                 Review[]
  sessions                Session[]
  wishlist                Wishlist?
  analyticsEvents         AnalyticsEvent[]
  notificationReads       AdminNotificationRead[]

  @@index([role])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// *
/// * Email ownership proof, deliberately mirroring PasswordResetToken: only a
/// * SHA-256 hash is stored, so a database leak cannot be replayed as a
/// * verification link. Single-use via `usedAt`, and time-limited.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  /// * The address being proved — a later email change re-verifies.
  email     String
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

/// *
/// * One row per email attempt.
/// *
/// * Serves three jobs at once without adding a queue or Redis: delivery history,
/// * idempotency (`dedupeKey` is unique, so a retried order cannot send a second
/// * confirmation), and rate limiting (count recent rows per recipient/template).
model EmailLog {
  id         String      @id @default(cuid())
  to         String
  template   String
  subject    String
  status     EmailStatus
  /// * Resend's message id, when the send succeeded.
  providerId String?
  /// * Provider error text on failure. Never contains tokens.
  error      String?
  /// *
  /// * Natural key for "this exact email, once". Null for mail that may
  /// * legitimately repeat, such as a second password reset request.
  dedupeKey  String?     @unique
  createdAt  DateTime    @default(now())

  @@index([to, template, createdAt])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  icon        String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Product {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  description      String
  shortDescription String?
  brand            String
  sku              String             @unique
  priceCents       Int
  compareAtCents   Int?
  categoryId       String
  featured         Boolean            @default(false)
  isActive         Boolean            @default(true)
  ratingAvg        Float              @default(0)
  reviewCount      Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  seoDescription   String?
  seoTitle         String?
  paddlePriceCents Int?
  paddlePriceId    String?            @unique
  /// Paddle catalogue link. `paddlePriceId` is the one-time price the checkout
  /// charges; `paddlePriceCents` records what that price was worth when it was
  /// last synced, so a drift between this row's `priceCents` and Paddle can be
  /// detected without an API call. All three are null until the product is
  /// synced — checkout refuses to sell an unsynced product rather than
  /// inventing a price.
  paddleProductId  String?            @unique
  paddleSyncedAt   DateTime?
  /// One optional product video, shown second in the product-page gallery.
  ///
  /// Held here rather than as a `ProductImage` row on purpose. Some twenty
  /// places read `images[0]` or `images[1]` as a picture — cards, cart,
  /// checkout (which snapshots it into `OrderItem.imageUrl`), order emails,
  /// share previews and structured data — and none of them should ever be
  /// handed a video. A separate, optional column keeps every one of them
  /// untouched and makes "at most one video" a property of the table.
  ///
  /// `videoStorageKey` is null when the product does not own the object — a
  /// duplicate shares its source's URL — so deleting that product can never
  /// destroy a video another product still shows.
  videoUrl         String?
  videoStorageKey  String?
  cartItems        CartItem[]
  customerProjects CustomerProject[]
  difficulty       ProductDifficulty?
  access           DigitalAccess[]
  asset            DigitalAsset?
  orderItems       OrderItem[]
  category         Category           @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  analyticsEvents  AnalyticsEvent[]

  @@index([categoryId])
  @@index([featured])
  @@index([isActive, createdAt])
  @@index([priceCents])
  @@index([ratingAvg])
  @@index([brand])
}

model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  url        String
  alt        String
  sortOrder  Int     @default(0)
  storageKey String?
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

/// *
/// * The purchasable file behind a product.
/// *
/// * The binary lives in private object storage; only the provider handle is
/// * stored here. `storageKey` must never be rendered into a page or an email —
/// * it is resolved to a short-lived signed URL by the download route, after
/// * authorisation. See lib/storage/digital.ts.
/// *
/// * One row per product. Replacing the file overwrites this row and bumps
/// * `version`, so a customer who bought v1 always gets whatever the current
/// * file is — which is the behaviour buyers of patterns and templates expect.
model DigitalAsset {
  id          String   @id @default(cuid())
  productId   String   @unique
  /// * Private storage handle. Never leaves the server.
  storageKey  String
  filename    String
  contentType String
  bytes       Int
  /// * Free-text, shown to buyers, e.g. "1.2" or "2026 edition".
  version     String   @default("1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// *
/// * How demanding a pattern is to make — the inputs only.
/// *
/// * Six ratings from 1 to 10, a time estimate in whole minutes and a set of
/// * techniques from the fixed vocabulary in lib/difficulty/techniques.ts. The
/// * overall score, the level and the "what makes it challenging" lines are
/// * never stored: lib/difficulty/engine.ts derives them, so there is one
/// * formula and no stored number that can drift away from it.
/// *
/// * One row per product. A product without a row has never been rated and
/// * shows nothing. `enabled` hides a rating without deleting it, so switching
/// * it back on restores exactly what an admin entered.
/// *
/// * The database also enforces the ranges with CHECK constraints (see the
/// * migration), which Prisma does not model — Zod is the first line, these
/// * are the backstop.
model ProductDifficulty {
  id             String   @id @default(cuid())
  productId      String   @unique
  enabled        Boolean  @default(true)
  stitches       Int
  construction   Int
  shaping        Int
  colorwork      Int
  assembly       Int
  patternReading Int
  minutesMin     Int
  minutesMax     Int
  /// * Technique slugs, stored in vocabulary order.
  techniques     String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id        String       @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String
  body      String
  /// *
  /// * Moderation state. Defaults to APPROVED so every review written before
  /// * moderation existed stays visible — the storefront must not silently
  /// * lose content the day this ships.
  status    ReviewStatus @default(APPROVED)
  /// * Orthogonal to `status`: a review is featured *and* approved, never
  /// * featured instead of approved.
  featured  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, createdAt])
  @@index([userId])
  @@index([status, createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

/// *
/// * A line in the bag.
/// *
/// * Points straight at the product: a digital file has no size, colour or stock,
/// * so there is nothing for a variant to distinguish. Quantity is retained
/// * because a buyer may want several licences of the same file.
model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  productId String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
}

/// *
/// * A digital order.
/// *
/// * No addresses, no shipping, no tracking. `userId` is required rather than
/// * optional: a download has to be authorised against an account, so there is no
/// * such thing as a guest purchase here.
/// *
/// * Money is stored in minor units of `currency` — never floats. `totalCents` is
/// * what the server calculated and what the provider is asked to charge; the
/// * webhook refuses to complete an order whose provider amount disagrees.
/// *
/// * Tax is deliberately not a column. Paddle is the merchant of record: it
/// * calculates, collects and remits sales tax on top of our price, and that
/// * money is never ours. Recording it here would imply we owe it to someone.
model Order {
  id            String          @id @default(cuid())
  orderNumber   String          @unique
  userId        String
  status        OrderStatus     @default(PENDING)
  /// * Snapshot — the order must survive the customer changing their address.
  email         String
  subtotalCents Int
  discountCents Int             @default(0)
  totalCents    Int
  couponId      String?
  couponCode    String?
  notes         String?
  placedAt      DateTime        @default(now())
  cancelledAt   DateTime?
  updatedAt     DateTime        @updatedAt
  completedAt   DateTime?
  /// * ISO 4217, upper case. Fixed per order at the moment of creation.
  currency      String          @default("USD")
  customerName  String
  refundedAt    DateTime?
  access        DigitalAccess[]
  coupon        Coupon?         @relation(fields: [couponId], references: [id])
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  payment       Payment?

  @@index([userId, placedAt])
  @@index([status])
  @@index([placedAt])
  @@index([email])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  productId      String?
  name           String
  slug           String
  sku            String
  imageUrl       String?
  unitPriceCents Int
  quantity       Int
  totalCents     Int
  access         DigitalAccess?
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?       @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

/// *
/// * The money side of an order.
/// *
/// * `providerTransactionId` is unique, which is what makes replayed webhooks
/// * safe: two events describing the same charge cannot produce two paid rows.
/// * No card number, expiry or CVC is ever stored — Paddle holds the instrument
/// * and returns only a brand and last four for display.
model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  status                PaymentStatus @default(PENDING)
  amountCents           Int
  cardBrand             String?
  cardLast4             String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  cancelledAt           DateTime?
  /// * Provider-hosted page the customer was sent to, for retry and support.
  checkoutUrl           String?
  currency              String        @default("USD")
  failedAt              DateTime?
  /// * Provider's reason string on failure. Never a credential.
  failureReason         String?
  /// * Driver name, e.g. "paddle" or "sandbox".
  provider              String
  /// * The provider's own id for this charge. Unique across the table.
  providerTransactionId String?       @unique
  refundedAt            DateTime?
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([provider, status])
}

/// *
/// * A processed webhook event.
/// *
/// * Written inside the same transaction that acts on the event, so the unique
/// * constraint on `(provider, eventId)` is what makes delivery idempotent: a
/// * replay hits the constraint, the transaction rolls back, and nothing is
/// * granted or emailed twice. Payload is not stored — it can contain customer
/// * details we have no reason to keep a second copy of.
model PaymentEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  type        String
  orderId     String?
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([orderId])
}

/// *
/// * Permission to download one purchased file.
/// *
/// * The row is the authorisation. The download route looks up nothing else: if
/// * there is no unrevoked row joining this user to this product through a paid
/// * order, there is no file. Changing an id in the URL therefore cannot work —
/// * see api/download/[productId]/route.ts.
/// *
/// * `orderItemId` is unique, so granting access twice for the same purchased
/// * line is impossible even if two webhooks race.
model DigitalAccess {
  id             String    @id @default(cuid())
  userId         String
  orderId        String
  orderItemId    String    @unique
  productId      String
  grantedAt      DateTime  @default(now())
  /// * Set when a refund lands. A revoked row denies the download.
  revokedAt      DateTime?
  revokedReason  String?
  downloadCount  Int       @default(0)
  lastDownloadAt DateTime?
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, grantedAt])
  @@index([userId, productId])
  @@index([orderId])
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  type          DiscountType
  value         Int
  minOrderCents Int          @default(0)
  maxUses       Int?
  usedCount     Int          @default(0)
  startsAt      DateTime     @default(now())
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  orders        Order[]

  @@index([isActive, expiresAt])
}

/// *
/// * What an administrator did, recorded as it happens.
/// *
/// * Written only by admin server actions, never backfilled — an audit trail
/// * that invents its own history is worse than none. `meta` carries the small
/// * amount of context an entry needs to be readable later (a product name, an
/// * order number); it never carries secrets.
model AdminActivity {
  id         String   @id @default(cuid())
  actorId    String
  /// * Machine-readable verb, e.g. "product.updated", "review.approved".
  action     String
  /// * "product" | "order" | "review" | "coupon" | "payment" | "category" | "email"
  entityType String
  /// * Null for actions that are not about one record, e.g. a bulk resync.
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

/// *
/// * A customer's photo of something they made from a pattern they bought.
/// *
/// * Deliberately not a `ProductImage`: some twenty places read a product's
/// * first image as *the* product picture, and none of them may ever be handed
/// * a customer's photo. Deliberately not a `Review` either — there is no
/// * rating here, and reviews stay the only rating system.
/// *
/// * Every row starts PENDING and only an admin moves it. The image is uploaded
/// * as a Cloudinary `authenticated` asset, so until approval it cannot be
/// * fetched by a plain URL. `imageKey` is the only handle; `imageUrl` stays
/// * null until a later phase publishes an approved image.
/// *
/// * Several rows per customer and product are allowed (at most three, enforced
/// * in lib/projects/mutations.ts), so there is no unique on (userId, productId).
/// * `imageKey` is unique: one row per stored asset, so an upload cannot be
/// * claimed twice.
/// *
/// * Product is `Restrict`, not `Cascade`. A project can only exist for a
/// * purchased product, and a purchased product is archived rather than deleted
/// * (see deleteProduct), so this never blocks the normal path — it only stops a
/// * mistaken hard delete from silently destroying customers' content.
model CustomerProject {
  id              String        @id @default(cuid())
  userId          String
  productId       String
  /// * Cloudinary public_id, inside the customer-projects folder and the
  /// * owner's prefix. Checked server-side; never taken on trust.
  imageKey        String        @unique
  /// * Public delivery URL. Null until an approved image is published.
  imageUrl        String?
  /// * Width, height, bytes and format as Cloudinary reported them — never as
  /// * the browser claimed.
  width           Int
  height          Int
  bytes           Int
  format          String
  /// * Plain text, at most 500 characters.
  caption         String?
  /// * Customer-chosen, at most 40 characters. Never derived from the email.
  displayName     String?
  status          ProjectStatus @default(PENDING)
  rejectionReason String?
  moderatedAt     DateTime?
  moderatedById   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation("CustomerProjectOwner", fields: [userId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  moderatedBy     User?         @relation("CustomerProjectModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// * Moderation state of a customer project. Always PENDING on creation.
enum ProjectStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum Role {
  CUSTOMER
  ADMIN
}

/// *
/// * Lifecycle of a digital order.
/// *
/// * There is no SHIPPED or DELIVERED: fulfilment is instantaneous and happens
/// * inside the same transaction that records the payment, so an order is either
/// * awaiting money, complete, abandoned, or reversed.
enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PROCESSING
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum EmailStatus {
  /// * No provider configured — nothing was sent, and we say so.
  SKIPPED
  SENT
  FAILED
}

/// Behaviour the rest of the schema cannot reconstruct: product page views,
/// add-to-cart, wishlist additions and completed downloads. Purchases, checkout
/// starts, reviews and current wishlist state are deliberately NOT recorded
/// here — Order, OrderItem, Review and WishlistItem stay the source of truth.
///
/// Minimal on purpose: no IP address, no user agent, no free-form metadata.
/// `visitorKey` is a salted hash that rotates daily, so an anonymous visitor
/// can be counted within a day but never followed across days.
model AnalyticsEvent {
  id         String             @id @default(cuid())
  type       AnalyticsEventType
  productId  String
  /// Set for signed-in cart, wishlist and download events. Never for views.
  userId     String?
  /// Daily-rotating anonymous key. Set for views only.
  visitorKey String?
  /// Units added, for ADD_TO_CART only.
  quantity   Int?
  createdAt  DateTime           @default(now())
  product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([productId, type, createdAt])
  @@index([userId])
}

enum AnalyticsEventType {
  PRODUCT_VIEW
  ADD_TO_CART
  WISHLIST_ADD
  DOWNLOAD
}

/// Something an administrator should know happened.
///
/// A notification is a record of a real occurrence, derived from the table
/// that is the authority for it — an order from `Order`, a review from
/// `Review`, a download from `AnalyticsEvent` — never an event of its own
/// invention. It is shared by every admin; whether each one has read it lives
/// in `AdminNotificationRead`, so one admin opening it does not hide it from
/// another.
///
/// `dedupeKey` is the idempotency guarantee. Each kind of occurrence has a
/// deterministic key (an order id, a product and a day, a product and a week),
/// and the unique constraint makes a second write of the same occurrence a
/// no-op however many times, or from however many servers, it is detected.
///
/// Holds no customer details: no email, no name, no payment reason. `href` is
/// always an internal /admin path, and `metadata` only what a row needs to
/// read well later (a product name, an order number, a count).
model AdminNotification {
  id         String                  @id @default(cuid())
  type       AdminNotificationType
  title      String
  message    String
  /// Where to go to act on it. Always an internal /admin path.
  href       String?
  entityType String?
  entityId   String?
  dedupeKey  String                  @unique
  /// When the underlying thing happened — not when it was noticed.
  occurredAt DateTime
  createdAt  DateTime                @default(now())
  metadata   Json?
  reads      AdminNotificationRead[]

  @@index([occurredAt])
  @@index([type, occurredAt])
  @@index([entityType, entityId])
}

/// One admin has read one notification.
///
/// The row's presence is the read state; its absence is unread. Deleting a
/// user or a notification removes the rows that refer to it.
model AdminNotificationRead {
  notificationId String
  userId         String
  readAt         DateTime          @default(now())
  notification   AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
}

enum AdminNotificationType {
  ORDER_COMPLETED
  PAYMENT_FAILED
  REVIEW_SUBMITTED
  PRODUCT_DOWNLOADED
  WISHLIST_ACTIVITY
  PRODUCT_ATTENTION
  PRODUCT_CONFIGURATION
}
