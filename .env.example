# ---------------------------------------------------------------------------
# Meemi Art — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (see prisma.config.ts).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/meemiart?schema=public"

# Auth.js. Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# Canonical origin. Used for auth callbacks, SEO canonical URLs, sitemap, OG
# tags, and — importantly — as the base for every link inside a transactional
# email. Emails are read outside the app, so a localhost value here ships
# unreachable links to customers. Set the real origin in production.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://meemiart.com"

# --- Payments (Paddle) -----------------------------------------------------
# See docs/PADDLE_SETUP.md for how to obtain every value below.
#
# To run against Paddle Sandbox, the full set is:
#
#   PAYMENT_PROVIDER=paddle
#   PADDLE_ENV=sandbox
#   PADDLE_API_KEY=<from Paddle sandbox dashboard>
#   NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=<test_... from the same dashboard>
#   PADDLE_WEBHOOK_SECRET=<from the notification destination>
#   PAYMENT_CURRENCY=USD
#
# To go LIVE, set these on the production host only — never in a local .env,
# and never committed. PAYMENT_PROVIDER is the one people forget: without it
# the app keeps using the built-in sandbox driver and no money moves, however
# correct the Paddle credentials are.
#
#   PAYMENT_PROVIDER=paddle
#   PADDLE_ENV=production                    -> switches the API base to api.paddle.com
#   PADDLE_API_KEY=<live key>                server-only, never NEXT_PUBLIC
#   NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_... must be a live_ token
#   PADDLE_WEBHOOK_SECRET=<live destination secret>
#   PAYMENT_CURRENCY=USD
#   NEXT_PUBLIC_SITE_URL=https://meemiart.com
#
# The server refuses checkout if PADDLE_ENV and the client token's prefix
# disagree, so a live server can never be paired with a test_ token.
#
# Which driver checkout uses. "sandbox" needs no credentials: it runs the whole
# order, webhook, access-grant and download pipeline locally, but moves no
# money and is refused in production builds pointed at a real domain. Left as
# the default so a fresh clone cannot reach a payment provider by accident.
#   sandbox | paddle
PAYMENT_PROVIDER="sandbox"

# Paddle is the merchant of record: it sells to the customer, calculates and
# remits sales tax, and owns the chargeback. The amount we ask for is the
# pre-tax price; Paddle adds tax at its own checkout.
#
# "sandbox" points at sandbox-api.paddle.com and charges test cards only.
# Anything other than an explicit "production" is treated as sandbox, so a
# missing value can never accidentally take live money.
PADDLE_ENV="sandbox"

# Paddle dashboard -> Developer tools -> Authentication. Server-only; never
# prefixed NEXT_PUBLIC.
PADDLE_API_KEY=""

# Paddle dashboard -> Developer tools -> Notifications -> your destination.
# Used to verify the Paddle-Signature header on every delivery. A webhook
# endpoint without this is an endpoint anyone can post a fake payment to.
PADDLE_WEBHOOK_SECRET=""

# Client-side token for Paddle.js. Safe to expose — it cannot authorise a
# charge on its own.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""

# Currency every order is priced in. ISO 4217.
PAYMENT_CURRENCY="USD"

# Optional. Signs sandbox webhooks so they cannot be forged by anyone who has
# read the source. Generated per process when unset, which is fine locally but
# means restarts invalidate in-flight test payments.
SANDBOX_WEBHOOK_SECRET=""

# --- Image storage (Cloudinary) --------------------------------------------
# Product preview images. Public by design and served straight off the CDN;
# only the resulting URL is written to the database. Leave these blank and
# uploads fall back to the local filesystem (public/uploads), which is fine for
# development but does NOT survive a serverless deploy.
#
# Find all three at cloudinary.com → Dashboard → Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional. Defaults to "meemiart/products".
CLOUDINARY_FOLDER="meemiart/products"

# Purchased files live in a *separate* private folder, uploaded with
# type=private so they cannot be fetched by their plain URL. A customer only
# ever reaches one through /api/download/[productId], which checks the session
# against a paid order before signing a link that expires in five minutes.
CLOUDINARY_DIGITAL_FOLDER="meemiart/digital-files"

# --- Transactional email (Resend) ------------------------------------------
# With RESEND_API_KEY unset, the app sends nothing and records every attempt in
# the EmailLog table as SKIPPED. It never reports an email as sent when it
# wasn't. Get a key at resend.com -> API Keys. Leave blank here — the real key
# belongs in .env, which is never committed.
RESEND_API_KEY=

# The sending identity. `meemiart.com` must be verified in Resend -> Domains
# before anything will deliver. To test without a verified domain, use
# "onboarding@resend.dev", which only delivers to the Resend account owner.
#
# The display name here is also the brand used in every subject line, heading
# and signature — there is no separate brand variable to keep in step.
EMAIL_FROM="Meemi Art <hello@meemiart.com>"
EMAIL_REPLY_TO="hello@meemiart.com"

# Optional. Where internal new-order notifications go. Defaults to the
# EMAIL_REPLY_TO address, so a shop with one mailbox can leave this unset.
ADMIN_EMAIL=

# Optional. Overrides NEXT_PUBLIC_SITE_URL as the base for links inside emails.
# Only needed when mail should point somewhere other than the canonical site.
NEXT_PUBLIC_APP_URL=

# --- Seeding -----------------------------------------------------------------
# `npm run db:seed` writes the six Meemi Art categories and nothing else. That is
# safe to run against a live store: it is idempotent and deletes nothing.
#
# There is no demo-data mode. Products are added from the admin dashboard,
# where a file has to be uploaded before one can be published — which is the
# only way to be sure a published product can actually be delivered.
